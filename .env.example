# Copia este ficheiro para ".env" (mesma pasta) e preenche com os teus dados reais.
# O ficheiro ".env" NUNCA deve ser partilhado, commitado no git, ou colado no chat.

VIVAGYM_EMAIL=o-teu-email@exemplo.com
VIVAGYM_PASSWORD=a-tua-password

# Nome do ginásio tal como aparece no site (ex: "Benfica")
GYM_NAME=Benfica

# Nome da aula tal como aparece no horário (ex: "V-Power")
CLASS_NAME=V-Power

# Dia da semana da aula: Segunda, Terca, Quarta, Quinta, Sexta, Sabado, Domingo
CLASS_DAY=Domingo

# Hora de início da aula, formato 24h HH:MM
CLASS_TIME=10:30

# API key da conta Resend (resend.com) usada para enviar o email de notificação.
# Opcional para testes locais; obrigatório para a versão que corre na cloud (GitHub Actions).
RESEND_API_KEY=

# Email para onde queres receber a notificação de sucesso/insucesso.
NOTIFY_EMAIL_TO=hugoca@gmail.com
